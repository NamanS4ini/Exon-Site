{
  "Function Declaration": {
    "prefix": "fxn",
    "body": [
      "fxn ${1:name}(${2:params}) {",
      "  ${0:// body}",
      "}"
    ],
    "description": "Declare a function in Exon"
  },
  "Class Declaration": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
      "  init(${2:params}) {",
      "    ${3:this.param = param;}",
      "  }",
      "}"
    ],
    "description": "Declare a class in Exon"
  },
  "Subclass Declaration": {
    "prefix": "class-sub",
    "body": [
      "class ${1:Subclass} < ${2:Superclass} {",
      "  init(${3:params}) {",
      "    ${0}",
      "  }",
      "}"
    ],
    "description": "Declare a subclass in Exon using <"
  },
  "Variable Declaration": {
    "prefix": "set",
    "body": [
      "set ${1:variable} = ${2:value};"
    ],
    "description": "Declare a variable in Exon using set"
  },
  "Print Statement": {
    "prefix": "out",
    "body": [
      "out ${1:expression};"
    ],
    "description": "Print value to stdout using out"
  },
  "For Loop": {
    "prefix": "for",
    "body": [
      "for (set ${1:i} = 0; ${1:i} < ${2:10}; ${1:i} = ${1:i} + 1) {",
      "  ${0}",
      "}"
    ],
    "description": "For loop statement"
  },
  "When Loop": {
    "prefix": "when",
    "body": [
      "when (${1:condition}) {",
      "  ${0}",
      "}"
    ],
    "description": "While-style when loop statement"
  },
  "If Statement": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "  ${0}",
      "}"
    ],
    "description": "If conditional statement"
  },
  "If Else Statement": {
    "prefix": "ifelse",
    "body": [
      "if (${1:condition}) {",
      "  ${2}",
      "} else {",
      "  ${0}",
      "}"
    ],
    "description": "If/Else conditional statement"
  }
}
